# GCP Configuration
GOOGLE_CLOUD_PROJECT=YOUR_GCP_PROJECT_ID
GOOGLE_APPLICATION_CREDENTIALS=keys/service-account.json

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_VERSION=v1
DEBUG=true

# Database
FIRESTORE_DATABASE=(default)

# Storage
GCS_BUCKET_NAME=YOUR_GCS_BUCKET_NAME

# ML Services
VERTEX_AI_LOCATION=us-central1
BIGQUERY_DATASET=YOUR_BIGQUERY_DATASET

# Authentication
JWT_SECRET_KEY=YOUR_JWT_SECRET_KEY
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# External APIs
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# AI backend for pitch-deck data extraction (app/services/parsing_service.py). Any
# OpenAI-compatible /v1/chat/completions endpoint works - defaults to a local Ollama
# instance so this runs with zero cloud credentials. Point at Vertex AI's OpenAI-compatible
# endpoint or plain OpenAI instead by changing these two values; no code change needed.
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=llama3.2

# Logging
LOG_LEVEL=INFO